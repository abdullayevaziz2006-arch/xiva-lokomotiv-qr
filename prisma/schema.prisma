generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique // Masalan: xiva-park, gold-gym
  logoUrl       String?
  trialEndsAt   DateTime       @default(now())
  status        String         @default("active") // active, suspended, expired
  createdAt     DateTime       @default(now())

  // Boshqa jadvallar bilan bog'liqlik
  users         User[]
  terminals     Terminal[]
  carousels     Carousel[]
  qrCodes       QRCode[]
  staff         Staff[]
  parkingLots   ParkingLot[]
}

model User {
  id             Int            @id @default(autoincrement())
  fullName       String
  phone          String         @unique
  passwordHash   String
  role           String         // admin, tadbirkor, kassir, superadmin
  organizationId Int
  isOwner        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  telegramChatId String?        @unique

  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdCodes   QRCode[]       @relation("CreatedBy")
  carousels      Carousel[]
}

model Terminal {
  id             Int        @id @default(autoincrement())
  name           String
  ipAddress      String
  port           String     @default("80")
  username       String
  password       String
  status         String     @default("active")
  organizationId Int
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  carousels      Carousel[]
}

model Carousel {
  id             Int        @id @default(autoincrement())
  name           String
  description    String?
  price          Int        @default(0)
  entrepreneurId Int
  terminalId     Int
  organizationId Int

  organization   Organization @relation(fields: [organizationId], references: [id])
  entrepreneur   User       @relation(fields: [entrepreneurId], references: [id])
  terminal       Terminal   @relation(fields: [terminalId], references: [id])
  qrCodes        QRCodeCarousel[]
}

model QRCode {
  id             Int      @id @default(autoincrement())
  qrString       String   @unique
  status         Int      @default(0) // 0-yaratildi, -1 bekor qilindi
  expiresAt      DateTime
  createdBy      Int
  organizationId Int
  customerName   String?  // AES-256 shifrlangan
  customerPhone  String? 
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  creator        User     @relation("CreatedBy", fields: [createdBy], references: [id])
  carousels      QRCodeCarousel[]
}

model QRCodeCarousel {
  id         Int      @id @default(autoincrement())
  qrCodeId   Int
  carouselId Int
  quantity   Int      @default(1)
  usedCount  Int      @default(0)
  status     Int      @default(0) // 0-Aktiv, 1-Ishlatilgan, -1-Vozvrat
  usedAt     DateTime?

  qrCode     QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  carousel   Carousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)

  @@unique([qrCodeId, carouselId])
}

// --- NEW: SmartStaff (SKUD) Models ---

model Staff {
  id             Int          @id @default(autoincrement())
  fullName       String
  employeeId     String       @unique // Terminaldagi employeeNoString
  organizationId Int
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  attendance     Attendance[]
}

model Attendance {
  id             Int      @id @default(autoincrement())
  staffId        Int
  timestamp      DateTime @default(now())
  direction      String   // IN, OUT
  terminalId     Int?
  
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

// --- SMARTPARK SHLAGBAUM MODELS ---

model ParkingLot {
  id             String   @id @default(uuid())
  name           String
  bankName       String?
  bankAccount    String?
  mfo            String?
  inn            String?
  telegramChatId String?
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  tariffs        Tariff[]
  sessions       ParkingSession[]
  devices        Device[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Car {
  id            String   @id @default(uuid())
  plateNumber   String   @unique
  isSubscriber  Boolean  @default(false)
  subscriberEnd DateTime?
  isBlacklisted Boolean  @default(false)
  cardNo        String?
  sessions      ParkingSession[]
  logs          Log[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Tariff {
  id          String   @id @default(uuid())
  name        String
  pricePerMin Float
  freeMinutes Int      @default(0)
  maxDaily    Float?
  lotId       String
  lot         ParkingLot @relation(fields: [lotId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ParkingSession {
  id          String   @id @default(uuid())
  carId       String
  car         Car      @relation(fields: [carId], references: [id])
  lotId       String
  lot         ParkingLot @relation(fields: [lotId], references: [id])
  entryTime   DateTime @default(now())
  exitTime    DateTime?
  fee         Float    @default(0)
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, UNPAID
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id          String   @id @default(uuid())
  sessionId   String
  session     ParkingSession @relation(fields: [sessionId], references: [id])
  amount      Float
  method      String   // CASH, PAYME, CLICK
  status      String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  createdAt   DateTime @default(now())
}

model Log {
  id          String   @id @default(uuid())
  type        String   // ENTRY, EXIT, BLACKLIST_ATTEMPT, BARRIER_OPEN
  carId       String?
  car         Car?     @relation(fields: [carId], references: [id])
  description String?
  createdAt   DateTime @default(now())
}

model Device {
  id        String   @id @default(uuid())
  name      String
  ipAddress String
  port      Int      @default(80)
  username  String?
  password  String?
  type      String   @default("ENTRY") // ENTRY, EXIT
  status    String   @default("ONLINE") // ONLINE, OFFLINE
  lotId     String
  lot       ParkingLot @relation(fields: [lotId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
